# Local-only environment for `./start_local.sh` (optional Google login).
#
# Copy this file to `.env.local` (which is git-ignored) and fill in real values. NEVER commit real
# credentials. start_local.sh sources `.env.local` automatically if it exists.
#
# Get these from the Google Cloud console OAuth 2.0 "Web application" client:
#   - Authorized redirect URI must be exactly: http://localhost:8090/api/auth/google/callback
#   - The app requests only the openid/email/profile scopes.
#
# The app boots fine WITHOUT these (login is simply disabled); set them to enable Sign in with Google.

export GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
export GOOGLE_OAUTH_SECRET=your-client-secret

# Optional overrides (defaults shown) -- only set if your ports differ:
# export GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8090/api/auth/google/callback
# export GOOGLE_OAUTH_SPA_CALLBACK_URI=http://localhost:5173/auth/callback
