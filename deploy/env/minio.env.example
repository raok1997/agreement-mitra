# Template for deploy/env/minio.env (gitignored).
# Real values are generated on the server by `./provision.sh secrets`.
# Every key carries a `#@` tag; the grammar is in backend.env.example's header.
#
# NOTE (tech debt): the backend authenticates to MinIO as root. A dedicated
# service account scoped to the `agreements` bucket is the correct end state and
# is worth doing before real PII lands. Tracked in docs/DEPLOYMENT.md.
#@ secret generated required pattern=^[A-Za-z0-9]{32,}$
MINIO_ROOT_USER=__GENERATED_ON_SERVER__
#@ secret generated required pattern=^[A-Za-z0-9]{32,}$
MINIO_ROOT_PASSWORD=__GENERATED_ON_SERVER__
