# Template for deploy/env/postgres.env (gitignored).
# Real values are generated on the server by `./provision.sh secrets`.
# Consumed by the postgres:17 image, which expects exactly these names.
# Every key carries a `#@` tag; the grammar is in backend.env.example's header.
#@ config fixed required
POSTGRES_DB=agreementmitra
#@ config fixed required
POSTGRES_USER=agreementmitra
#@ secret generated required pattern=^[A-Za-z0-9]{32,}$
POSTGRES_PASSWORD=__GENERATED_ON_SERVER__
