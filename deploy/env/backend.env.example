# Template for `deploy/env/backend.env` -- the gitignored file the `backend`
# service reads via `env_file` in docker-compose.prod.yml.
#
# Generate it on the SERVER with `./provision.sh secrets`, which fills every
# GENERATED value and leaves the vendor keys below for you to paste in. Never
# fill this in on a workstation, never paste real values into a chat window,
# never commit the result. See docs/DEPLOYMENT.md section 3.
#
# FORMAT: compose `env_file` parses plain KEY=value only. No `export`, no shell
# expansion, no quotes-with-meaning -- a value is taken literally to end of line.
#
# Three classes of value below:
#   [FIXED]     correct as written for this compose stack; do not change
#   [GENERATED] a secret created on the server; never copied from a laptop
#   [VENDOR]    issued by a third party; the only class legitimately copied in

# --- Profile and logging --------------------------------------------------
# [FIXED] REQUIRED. Without it the template catalog is empty and /start fails
# with "Could not load templates" -- TemplateCatalogSeeder and RegistryLayerSource
# are gated to @Profile({"local","sandbox"}). Use `sandbox`, NOT `local`.
SPRING_PROFILES_ACTIVE=sandbox
# [FIXED] INFO is also the application.yml default; set explicitly so a DEBUG
# override is a visible, deliberate edit. DEBUG is for a bounded diagnosis only.
LOGGING_LEVEL_IN_AGREEMENTMITRA=INFO

# --- Database -------------------------------------------------------------
# [FIXED] compose network hostname, not localhost. Keep logServerErrorDetail=false:
# without it a unique violation logs the raw agreement id at ERROR.
DB_URL=jdbc:postgresql://postgres:5432/agreementmitra?logServerErrorDetail=false
DB_USER=agreementmitra
# [GENERATED] must match POSTGRES_PASSWORD in postgres.env.
DB_PASSWORD=

# --- Object storage -------------------------------------------------------
# [FIXED] compose network hostname.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=agreements
# [GENERATED] must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in minio.env.
# NEVER the local compose defaults (minioadmin/minioadmin from start_local.sh).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Draft retention ------------------------------------------------------
# [FIXED] REQUIRED in production: terms of service section 10 promises that an unpaid draft
# unedited for 90 days is deleted. Off by default everywhere else, because the run deletes objects
# in whatever bucket it points at -- a cloned database against a shared bucket would purge this
# environment's live agreements. Each environment MUST have its own S3_BUCKET. Unset only as an
# incident lever. See docs/DEPLOYMENT.md "Draft retention is opt-in".
SIGNING_DRAFT_RETENTION_ENABLED=true

# --- Rendering ------------------------------------------------------------
# [FIXED] compose network hostname.
GOTENBERG_URL=http://gotenberg:3000

# --- Peppers (both have working dev defaults: unset means known-weak) -----
# [GENERATED] keys the hash of session/handoff/login-state values.
# Default is `dev-only-identity-pepper-change-me`.
AUTH_HASH_PEPPER=
# [GENERATED] keys encryption of the per-transaction eSign webhook key at rest.
# Default is `dev-only-webhook-key-pepper-change-me`. That key authenticates
# inbound state changes, so a weak pepper means a database read yields a
# working credential.
ESIGN_WEBHOOK_KEY_PEPPER=

# --- Public URLs ----------------------------------------------------------
# [FIXED] Used to build the recovery link emailed to the parties. Default is
# http://localhost:5173, which would send customers a dead link. Taken from
# config and never from a Host header (a spoofed Host would rewrite the link).
PUBLIC_BASE_URL=https://agreementmitra.com
# [FIXED] non-secret provenance URL in the rendered PDF footer.
DOCUMENT_FOOTER_PLATFORM_URL=agreementmitra.com

# --- eSign (ZOOP is the default adapter; leegality is the rollback) -------
ESIGN_PROVIDER=zoop
# [FIXED] The free self-serve TEST host. Repo policy is sandbox + dummy data
# only, so this stays the test host until a production ZOOP account exists.
# Changing it to the live host burns real signature credit.
ZOOP_BASE_URL=https://test.zoop.plus/contract/esign/
# [VENDOR] from the ZOOP console. Blank is tolerated at startup -- the adapter
# reads config at request time, so signing fails later, not at boot.
ZOOP_APP_ID=
ZOOP_API_KEY=
# [FIXED] Where ZOOP POSTs completions. Must be publicly reachable or the
# callback never arrives and signatures only complete via reconciliation.
ZOOP_RESPONSE_URL=https://agreementmitra.com/api/webhooks/esign
# [FIXED] Where a signer lands after signing. This is a single static URL, so
# it cannot be per-agreement; the landing page is the safe target.
ZOOP_REDIRECT_URL=https://agreementmitra.com/

# --- Payments -------------------------------------------------------------
# [FIXED] REQUIRED is the application default. Leaving it REQUIRED with blank
# Razorpay keys below means checkout fails at request time, not at boot. Set
# DISABLED if you are bringing the box up before the gateway account exists.
PAYMENT_MODE=REQUIRED
# [VENDOR] from the Razorpay dashboard. TEST keys here mean payments never
# settle; the webhook secret is issued per registered webhook URL, so a prod
# webhook registered at https://agreementmitra.com/api/webhooks/razorpay has
# its own secret -- it is not the one from your local test setup.
RAZORPAY_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=

# --- Paid-fulfilment eligibility ------------------------------------------
# [FIXED] `rules` is the only source of paid-fulfilment eligibility: a state is
# chargeable when its rule carries a counsel review matching its hash, OR this
# flag is true. Both shipped rule sets (TG, KA) are UNREVIEWED, and there is no
# application-sandbox.yml, so the sandbox profile inherits the `false` default
# and NO state is chargeable -- paid fulfilment is blocked for every customer.
# `true` is marked "sandbox / founding-team beta only" in the rule files.
# The first paid release sets this `false`: `true` would also make the unreviewed
# commercial rules chargeable, and v1 is residential only (docs/ROADMAP.md,
# "Ops / config: stop charging on unreviewed rules").
# Set deliberately; see docs/DEPLOYMENT.md section 3.
RULES_STAMP_DUTY_ALLOW_UNREVIEWED=true

# --- Mail (Zoho) ----------------------------------------------------------
# [FIXED] Default is `stub`: delivery reports success and sends nothing. The
# email channel is enabled by default, so a stub provider fails silently.
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=smtp.zoho.in
MAIL_SMTP_PORT=587
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
MAIL_FROM=support@agreementmitra.com
MAIL_FROM_NAME=AgreementMitra
# [VENDOR] Zoho mailbox user + app-specific password (not the account password).
MAIL_SMTP_USERNAME=support@agreementmitra.com
MAIL_SMTP_PASSWORD=

# --- Google login (optional) ---------------------------------------------
# [VENDOR] blank disables the handshake with a one-line WARN; the app still
# boots and anonymous use is unaffected.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
# [FIXED] must be registered VERBATIM as an authorized redirect URI in the
# Google Cloud console, alongside the localhost one used for dev.
GOOGLE_OAUTH_REDIRECT_URI=https://agreementmitra.com/api/auth/google/callback
GOOGLE_OAUTH_SPA_CALLBACK_URI=https://agreementmitra.com/auth/callback

# --- Browser-session cookies ------------------------------------------------
# [FIXED] leave unset (default `true`) in production: the session and CSRF
# cookies are `__Host-` prefixed and `Secure`. `false` is for plain-http LAN /
# Safari testing only, and startup REFUSES it while either Google URI above is
# https.
# AUTH_COOKIE_SECURE=true

# --- Leegality (rollback adapter; unused while ESIGN_PROVIDER=zoop) -------
LEEGALITY_BASE_URL=
LEEGALITY_PROFILE_ID=
LEEGALITY_AUTH_TOKEN=
LEEGALITY_WEBHOOK_SECRET=

# --- Operating entity (KAVISAT TEK LABS LLP) --------------------------------
# [VENDOR] public statutory identifiers, not secrets. Leave BLANK until issued:
# blank renders as "being issued" and is the honest state. A non-blank value
# that is malformed REFUSES STARTUP (OPERATOR_GSTIN must be a valid firm GSTIN:
# structure, holder type F, check character). Never type a placeholder.
# The LLPIN is also set in web-build.env and on Cloudflare Pages -- all three.
OPERATOR_LLPIN=
# Backend only; reaches invoices, never the website.
OPERATOR_GSTIN=
