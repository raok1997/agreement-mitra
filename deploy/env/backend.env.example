# Template for `deploy/env/backend.env` -- the gitignored file the `backend`
# service reads via `env_file` in docker-compose.prod.yml.
#
# Generate it on the SERVER with `./provision.sh secrets`, which fills every
# generated value and asks for the vendor keys below. Never fill this in on a
# workstation, never paste real values into a chat window, never commit the
# result. See docs/DEPLOYMENT.md section 3.
#
# FORMAT: compose `env_file` parses plain KEY=value only. No `export`, no shell
# expansion, no quotes-with-meaning -- a value is taken literally to end of line.
#
# TAGS: every assigned key carries a `#@` line directly above it (a value runs to
# end of line, so the tag cannot trail it). `deploy/deploy.sh` refuses a deploy
# whose env files break a tag, and deploy/test/templates.test.sh refuses an
# untagged key, so a new key is not done until it is tagged.
#
#   #@ <kind> <class> <need> [pattern=<ERE>] [match=<file>:<KEY>]
#   kind   secret   never printed by any script
#          config   may be displayed (the fill step shows old -> new)
#   class  fixed     the stack decides the value; the server must equal this file
#          setting   an operator choice; this file holds the default, the server
#                    may differ, only `pattern` is checked
#          generated created on the server by `provision.sh secrets` (secret required)
#          vendor    issued by a third party and typed in by the operator
#   need   required | optional | required-if=<CONFIG_KEY>=<VALUE>
#
# CHOOSING A TAG for a new key:
#   - `fixed` if the stack decides the value, `setting` if an operator may change it
#     on the server (a `fixed` edit on the server FAILS the deploy; a `setting` never does);
#   - `generated` if the server creates it, `vendor` if a third party issues it;
#   - `secret` unless the value may be displayed;
#   - `required-if` when a mode key (a `config` key in this file) decides whether it matters.
# Worked examples, one per class:
#   #@ config fixed required                      GOTENBERG_URL=http://gotenberg:3000
#   #@ config setting required pattern=^(REQUIRED|DISABLED)$   PAYMENT_MODE=REQUIRED
#   #@ secret generated required pattern=^[A-Za-z0-9]{32,}$    AUTH_HASH_PEPPER=
#   #@ secret vendor required-if=PAYMENT_MODE=REQUIRED         RZP_KEY_SECRET=

# --- Profile and logging --------------------------------------------------
# REQUIRED. Without it the template catalog is empty and /start fails
# with "Could not load templates" -- TemplateCatalogSeeder and RegistryLayerSource
# are gated to @Profile({"local","sandbox"}). Use `sandbox`, NOT `local`.
#@ config fixed required
SPRING_PROFILES_ACTIVE=sandbox
# INFO is also the application.yml default; set explicitly so a DEBUG
# override is a visible, deliberate edit. DEBUG is for a bounded diagnosis only.
#@ config setting required pattern=^(TRACE|DEBUG|INFO|WARN|ERROR)$
LOGGING_LEVEL_IN_AGREEMENTMITRA=INFO

# --- Database -------------------------------------------------------------
# Compose network hostname, not localhost. Keep logServerErrorDetail=false:
# without it a unique violation logs the raw agreement id at ERROR.
#@ config fixed required
DB_URL=jdbc:postgresql://postgres:5432/agreementmitra?logServerErrorDetail=false
#@ config fixed required
DB_USER=agreementmitra
# Must match POSTGRES_PASSWORD in postgres.env.
#@ secret generated required pattern=^[A-Za-z0-9]{32,}$ match=postgres.env:POSTGRES_PASSWORD
DB_PASSWORD=

# --- Object storage -------------------------------------------------------
# Compose network hostname.
#@ config fixed required
S3_ENDPOINT=http://minio:9000
#@ config fixed required
S3_BUCKET=agreements
# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in minio.env.
# NEVER the local compose defaults (minioadmin/minioadmin from start_local.sh).
# The access key is MinIO's root USER name (3+ chars; prod's predates 32-char generation and
# re-keying MinIO is not worth it); the secret key is the password and stays 32+.
#@ secret generated required pattern=^[A-Za-z0-9]{3,}$ match=minio.env:MINIO_ROOT_USER
S3_ACCESS_KEY=
#@ secret generated required pattern=^[A-Za-z0-9]{32,}$ match=minio.env:MINIO_ROOT_PASSWORD
S3_SECRET_KEY=

# --- Draft retention ------------------------------------------------------
# REQUIRED in production: terms of service section 10 promises that an unpaid draft
# unedited for 90 days is deleted. Off by default everywhere else, because the run deletes objects
# in whatever bucket it points at -- a cloned database against a shared bucket would purge this
# environment's live agreements. Each environment MUST have its own S3_BUCKET. Unset only as an
# incident lever. See docs/DEPLOYMENT.md "Draft retention is opt-in".
#@ config setting required pattern=^(true|false)$
SIGNING_DRAFT_RETENTION_ENABLED=true

# --- Rendering ------------------------------------------------------------
# Compose network hostname.
#@ config fixed required
GOTENBERG_URL=http://gotenberg:3000

# --- Peppers (both have working dev defaults: unset means known-weak) -----
# Keys the hash of session/handoff/login-state values.
# Default is `dev-only-identity-pepper-change-me`.
#@ secret generated required pattern=^[A-Za-z0-9]{32,}$
AUTH_HASH_PEPPER=
# Keys encryption of the per-transaction eSign webhook key at rest.
# Default is `dev-only-webhook-key-pepper-change-me`. That key authenticates
# inbound state changes, so a weak pepper means a database read yields a
# working credential.
#@ secret generated required pattern=^[A-Za-z0-9]{32,}$
ESIGN_WEBHOOK_KEY_PEPPER=

# --- Public URLs ----------------------------------------------------------
# Used to build the recovery link emailed to the parties. Default is
# http://localhost:5173, which would send customers a dead link. Taken from
# config and never from a Host header (a spoofed Host would rewrite the link).
#@ config fixed required
PUBLIC_BASE_URL=https://agreementmitra.com
# Non-secret provenance URL in the rendered PDF footer.
#@ config fixed required
DOCUMENT_FOOTER_PLATFORM_URL=agreementmitra.com

# --- eSign (ZOOP is the default adapter; leegality is the rollback) -------
#@ config setting required pattern=^(zoop|leegality)$
ESIGN_PROVIDER=zoop
# The free self-serve TEST host. Repo policy is sandbox + dummy data
# only, so this stays the test host until a production ZOOP account exists.
# Changing it to the live host burns real signature credit.
#@ config setting required pattern=^https://
ZOOP_BASE_URL=https://test.zoop.plus/contract/esign/
# From the ZOOP console. The adapter reads config at request time, so a
# blank fails signing later, not at boot -- which is why the deploy refuses it.
#@ secret vendor required-if=ESIGN_PROVIDER=zoop
ZOOP_APP_ID=
#@ secret vendor required-if=ESIGN_PROVIDER=zoop
ZOOP_API_KEY=
# Where ZOOP POSTs completions. Must be publicly reachable or the
# callback never arrives and signatures only complete via reconciliation.
#@ config fixed required
ZOOP_RESPONSE_URL=https://agreementmitra.com/api/webhooks/esign
# Where a signer lands after signing. This is a single static URL, so
# it cannot be per-agreement. /start is what prod ran its end-to-end ZOOP signing with
# (2026-10-06). It drops every signer -- landlord and tenant included -- on "create an
# agreement"; if that confuses signers, switch to the landing page https://agreementmitra.com/
# here (and on the server via `./provision.sh secrets`).
#@ config fixed required
ZOOP_REDIRECT_URL=https://agreementmitra.com/start
# Organisation name in the invitation email ZOOP sends each signer.
#@ config fixed required
ZOOP_ORG_NAME=AgreementMitra

# --- Payments -------------------------------------------------------------
# REQUIRED is the application default. Leaving it REQUIRED with blank
# Razorpay keys below means checkout fails at request time, not at boot. Set
# DISABLED if you are bringing the box up before the gateway account exists.
#@ config setting required pattern=^(REQUIRED|DISABLED)$
PAYMENT_MODE=REQUIRED
# From the Razorpay dashboard. TEST keys here mean payments never
# settle; the webhook secret is issued per registered webhook URL, so a prod
# webhook registered at https://agreementmitra.com/api/webhooks/razorpay has
# its own secret -- it is not the one from your local test setup.
# The first paid release tightens the key-id pattern to ^rzp_live_ (docs/ROADMAP.md).
#@ config vendor required-if=PAYMENT_MODE=REQUIRED pattern=^rzp_(test|live)_[A-Za-z0-9]+$
RAZORPAY_KEY_ID=
#@ secret vendor required-if=PAYMENT_MODE=REQUIRED
RZP_KEY_SECRET=
#@ secret vendor required-if=PAYMENT_MODE=REQUIRED
RZP_WEBHOOK_SECRET=

# --- Paid-fulfilment eligibility ------------------------------------------
# `rules` is the only source of paid-fulfilment eligibility: a state is
# chargeable when its rule carries a counsel review matching its hash, OR this
# flag is true. Both shipped rule sets (TG, KA) are UNREVIEWED, and there is no
# application-sandbox.yml, so the sandbox profile inherits the `false` default
# and NO state is chargeable -- paid fulfilment is blocked for every customer.
# `true` is marked "sandbox / founding-team beta only" in the rule files.
# The first paid release sets this `false`: `true` would also make the unreviewed
# commercial rules chargeable, and v1 is residential only (docs/ROADMAP.md,
# "Ops / config: stop charging on unreviewed rules").
# Set deliberately; see docs/DEPLOYMENT.md section 3.
#@ config setting required pattern=^(true|false)$
RULES_STAMP_DUTY_ALLOW_UNREVIEWED=true

# --- Mail (Zoho) ----------------------------------------------------------
# Default is `stub`: delivery reports success and sends nothing. The
# email channel is enabled by default, so a stub provider fails silently.
#@ config setting required pattern=^(smtp|stub)$
MAIL_PROVIDER=smtp
#@ config fixed required
MAIL_SMTP_HOST=smtp.zoho.in
#@ config fixed required
MAIL_SMTP_PORT=587
#@ config fixed required
MAIL_SMTP_STARTTLS=true
#@ config fixed required
MAIL_SMTP_SSL=false
#@ config fixed required
MAIL_FROM=support@agreementmitra.com
#@ config fixed required
MAIL_FROM_NAME=AgreementMitra
# Zoho mailbox user + app-specific password (not the account password).
#@ config fixed required
MAIL_SMTP_USERNAME=support@agreementmitra.com
#@ secret vendor required-if=MAIL_PROVIDER=smtp
MAIL_SMTP_PASSWORD=

# --- Google login (optional) ---------------------------------------------
# Blank disables the handshake with a one-line WARN; the app still
# boots and anonymous use is unaffected.
#@ config vendor optional
GOOGLE_OAUTH_CLIENT_ID=
#@ secret vendor optional
GOOGLE_OAUTH_SECRET=
# Must be registered VERBATIM as an authorized redirect URI in the
# Google Cloud console, alongside the localhost one used for dev.
#@ config fixed required
GOOGLE_OAUTH_REDIRECT_URI=https://agreementmitra.com/api/auth/google/callback
#@ config fixed required
GOOGLE_OAUTH_SPA_CALLBACK_URI=https://agreementmitra.com/auth/callback

# --- Browser-session cookies ------------------------------------------------
# Leave unset (default `true`) in production: the session and CSRF
# cookies are `__Host-` prefixed and `Secure`. `false` is for plain-http LAN /
# Safari testing only, and startup REFUSES it while either Google URI above is
# https.
# AUTH_COOKIE_SECURE=true

# --- Leegality (rollback adapter; unused while ESIGN_PROVIDER=zoop) -------
#@ config vendor required-if=ESIGN_PROVIDER=leegality pattern=^https://
LEEGALITY_BASE_URL=
#@ secret vendor required-if=ESIGN_PROVIDER=leegality
LEEGALITY_PROFILE_ID=
#@ secret vendor required-if=ESIGN_PROVIDER=leegality
LEEGALITY_AUTH_TOKEN=
#@ secret vendor required-if=ESIGN_PROVIDER=leegality
LEEGALITY_WEBHOOK_SECRET=

# --- Operating entity (KAVISAT TEK LABS LLP) --------------------------------
# Public statutory identifiers, not secrets. Leave BLANK until issued:
# blank renders as "being issued" and is the honest state. A non-blank value
# that is malformed REFUSES STARTUP (OPERATOR_GSTIN must be a valid firm GSTIN:
# structure, holder type F, check character). Never type a placeholder.
# The LLPIN is also set in web-build.env and on Cloudflare Pages -- all three.
#@ config vendor optional pattern=^[A-Z]{3}-[0-9]{4}$
OPERATOR_LLPIN=
# Backend only; reaches invoices, never the website.
#@ config vendor optional pattern=^[0-9]{2}[A-Z]{3}F[A-Z][0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$
OPERATOR_GSTIN=
