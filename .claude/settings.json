{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials*)",
      "Bash(cat .env*)",
      "Bash(cat *.env)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(rm -rf*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Edit(./.env)",
      "Write(./.env)",
      "Edit(./.env.*)",
      "Write(./.env.*)",
      "Edit(./**/.env)",
      "Write(./**/.env)",
      "Edit(./**/.env.*)",
      "Write(./**/.env.*)",
      "Edit(./**/*.pem)",
      "Write(./**/*.pem)",
      "Edit(./**/*.key)",
      "Write(./**/*.key)",
      "Edit(./**/secrets/**)",
      "Write(./**/secrets/**)",
      "Edit(./**/credentials*)",
      "Write(./**/credentials*)"
    ],
    "ask": [
      "Bash(./gradlew bootRun*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(docker compose down*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "allow": [
      "Read(./**)",
      "Grep",
      "Glob",
      "Skill",
      "Bash(./gradlew test*)",
      "Bash(./gradlew build*)",
      "Bash(./gradlew spotlessApply*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(docker compose up*)",
      "Bash(openspec status:*)",
      "Bash(openspec instructions:*)",
      "Bash(openspec validate:*)",
      "Bash(openspec list:*)",
      "Bash(openspec show:*)",
      "Bash(npx openspec:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(cd:*)",
      "Bash(jq:*)",
      "Bash(./gradlew check*)",
      "Bash(./gradlew securityScan*)",
      "Bash(./run-tests.sh)",
      "Bash(./run-tests.sh *)",
      "Bash(./scripts/sweep-test-containers.sh)",
      "Bash(osv-scanner scan *)",
      "Bash(osv-scanner --version)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "Bash(docker context *)",
      "Bash(docker info)",
      "Bash(openspec diff:*)",
      "Bash(openspec ls:*)",
      "Bash(openspec view:*)",
      "Bash(openspec change:*)",
      "Bash(openspec spec:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git stash list:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list:*)",
      "Bash(git config --get:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(openspec --version)",
      "Bash(openspec explore:*)",
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pii-secret-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
