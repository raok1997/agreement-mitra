{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "remoteControlAtStartup": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.prod)",
      "Read(./**/.env.prod)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Read(./*.env)",
      "Read(./**/*.env)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.env.local)",
      "Edit(./**/.env.local)",
      "Edit(./.env.prod)",
      "Edit(./**/.env.prod)",
      "Edit(./.env.production)",
      "Edit(./**/.env.production)",
      "Edit(./.env.staging)",
      "Edit(./**/.env.staging)",
      "Edit(./.env.development)",
      "Edit(./**/.env.development)",
      "Edit(./.env.test)",
      "Edit(./**/.env.test)",
      "Edit(./*.env)",
      "Edit(./**/*.env)",
      "Write(./.env)",
      "Write(./**/.env)",
      "Write(./.env.local)",
      "Write(./**/.env.local)",
      "Write(./.env.prod)",
      "Write(./**/.env.prod)",
      "Write(./.env.production)",
      "Write(./**/.env.production)",
      "Write(./.env.staging)",
      "Write(./**/.env.staging)",
      "Write(./.env.development)",
      "Write(./**/.env.development)",
      "Write(./.env.test)",
      "Write(./**/.env.test)",
      "Write(./*.env)",
      "Write(./**/*.env)",
      "Bash(cat .env*)",
      "Bash(cat *.env)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(rm -rf*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "Grep",
      "Glob",
      "Skill",
      "Agent",
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pii-secret-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
